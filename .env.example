# Copy to .env and replace every secret; never commit .env.
DB_PASSWORD=replace-with-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
REDIS_PASSWORD=replace-with-random-redis-password
JWT_SECRET=replace-with-at-least-32-random-bytes-secret
ADMIN_PASSWORD=replace-with-strong-admin-password
HTTP_PORT=8088
APP_VERSION=local
