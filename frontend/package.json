    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1",
